{
  "manifest_version": 3,
  "name": "FitPredictor",
  "version": "1.1.0",
  "description": "Privacy-first fit guidance from page charts, reviews, and local models",
  "action": {
    "default_title": "Open FitPredictor"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
